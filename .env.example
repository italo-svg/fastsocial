# Supabase self-hospedado (roda no VPS — ver infra/supabase/)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
DIRECT_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Infra própria
REDIS_URL=redis://redis:6379
RENDER_ENGINE_URL=http://fastsocial-render-engine:3334

# IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
FAL_API_KEY=
IMAGE_GEN_REFERENCE_WEIGHT=0.45
IMAGE_QA_THRESHOLD=6.0

# Bancos de imagem
UNSPLASH_ACCESS_KEY=

# Pesquisa & tendencias (spec 021)
META_ADS_LIBRARY_ACCESS_TOKEN=
ENABLE_COMPETITOR_SCRAPING=false

# Meta (Instagram + Facebook) — publicação + automação de DM (Módulo 19)
META_APP_ID=
META_APP_SECRET=

# LinkedIn (spec 029 — Caminho B: OAuth e publicação direto na API do
# LinkedIn, sem passar pelo Postiz, porque ele não custodia documento/PDF de
# forma confiável — ver infra/postiz/README.md)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202501
# TOKEN_ENCRYPTION_KEY: 32 bytes em hex (64 caracteres) — gerar com
# `openssl rand -hex 32`. Cifra os tokens OAuth do LinkedIn em repouso e
# assina o `state` do fluxo OAuth (TokenEncryptionService).
TOKEN_ENCRYPTION_KEY=
# API_PUBLIC_URL: URL pública desta própria API (não a do painel/APP_BASE_URL)
# — usada para montar o redirect_uri do callback OAuth do LinkedIn.
API_PUBLIC_URL=https://api.fastsocial.volupia.cloud

# Postiz (self-hosted, já existente no VPS, reusado pelo FastSocial — spec 027/028)
# A API key não é global: cada workspace ganha sua própria Organization no
# Postiz sob demanda, com a apiKey guardada em workspaces.postiz_api_key.
# POSTIZ_DATABASE_URL é necessária só para provisionar essas organizations
# (a API pública do Postiz não expõe esse endpoint).
POSTIZ_API_URL=http://volupia_postiz:3000
POSTIZ_DATABASE_URL=

# n8n (self-hosted, já existente no VPS)
N8N_API_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_SERVICE_TOKEN=

# Stripe (planos + add-ons)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observabilidade
GLITCHTIP_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=

# App
APP_BASE_URL=
NEXT_PUBLIC_API_URL=
