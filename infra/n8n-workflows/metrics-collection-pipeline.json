      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-publications",
      "name": "Loop Publications",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PENDENTE — endpoint do spec 038 (analytics-coleta-metricas) ainda não existe",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "publicationId", "value": "={{ $json.id }}" },
            { "name": "network", "value": "={{ $json.socialAccount.network }}" },
            { "name": "externalAccountId", "value": "={{ $json.socialAccount.externalAccountId }}" }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "http-coletar-metricas",
      "name": "Coletar Métricas (BLOQUEADO — spec 038)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "continueOnFail": true,
      "notes": "URL provisória — este node não deve ser ativado até o spec 038 entregar um endpoint real (algo como POST /internal/publications/:id/analytics-snapshot) que consulte a Graph API/LinkedIn API para esta publication específica e grave um analytics_snapshots. Documentado assim em vez de fingir uma URL funcional, conforme instrução explícita do spec 035.",
      "credentials": {
        "httpHeaderAuth": { "id": "fastsocial-service-token", "name": "FastSocial Service Token" }
      }
    },
    {
      "parameters": {
        "amount": 2
      },
      "id": "wait-entre-publications",
      "name": "Aguardar (rate limit)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 200]
    }
