    "Coletar Métricas (BLOQUEADO — spec 038)": {
      "main": [[{ "node": "Aguardar (rate limit)", "type": "main", "index": 0 }]]
    },
    "Aguardar (rate limit)": {
      "main": [[{ "node": "Loop Publications", "type": "main", "index": 0 }]]
