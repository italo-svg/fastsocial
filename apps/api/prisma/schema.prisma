// Schema do FastSocial — fonte da verdade: .prd/prd_autocontent_os.md, Secao 6
// auth.users e gerenciado pelo GoTrue (Supabase self-hosted) - nao modelado aqui.
// public.users.id == auth.users.id (tipo nativo uuid, para casar com auth.uid() nas policies RLS),
// populado via trigger handle_new_user() (SQL manual, ver manual-sql/).
// Todo campo que guarda um UUID usa @db.Uuid explicitamente — sem isso o Prisma mapeia
// String para TEXT, o que quebra comparacoes com auth.uid() (tipo uuid nativo) em RLS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================
// NUCLEO: WORKSPACES, USERS, MEMBERS
// ============================================================

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  planType  String   @default("trial") @map("plan_type")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  members           WorkspaceMember[]
  brandKit          BrandKit?
  templateAssets    TemplateAsset[]
  researchInsights  ResearchInsight[]
  contentPieces     ContentPiece[]
  socialAccounts    SocialAccount[]
  autopilotPipeline AutopilotPipeline?
  subscription      Subscription?
  auditLogs         AuditLog[]
  invites           WorkspaceInvite[]
  addons            WorkspaceAddon[]
  automationFlows   AutomationFlow[]

  @@map("workspaces")
}

model User {
  id           String   @id @db.Uuid
  email        String   @unique
  name         String
  authProvider String   @default("email") @map("auth_provider")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships    WorkspaceMember[]
  createdContent ContentPiece[]        @relation("ContentCreatedBy")
  auditLogs      AuditLog[]
  systemPrompts  SystemPrompt[]        @relation("PromptUpdatedBy")
  promptVersions SystemPromptVersion[]
  helpArticles   HelpArticle[]
  changelogs     ChangelogEntry[]
  funnelEvents   FunnelEvent[]

  @@map("users")
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String
  invitedAt   DateTime  @default(now()) @map("invited_at")
  joinedAt    DateTime? @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String
  role        String
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_invites")
}

// ============================================================
// BRAND KIT & TEMPLATES
// ============================================================

model BrandKit {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @unique @map("workspace_id") @db.Uuid
  niche              String?
  competitors        Json     @default("[]")
  toneOfVoice        String?  @map("tone_of_voice")
  colorPalette       Json     @default("{}") @map("color_palette")
  typography         Json     @default("{}")
  logoUrl            String?  @map("logo_url")
  defaultImageSource String   @default("own_library") @map("default_image_source")
  referenceImages    Json     @default("[]") @map("reference_images")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

model TemplateAsset {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String?   @map("workspace_id") @db.Uuid
  source           String    @default("system")
  format           String
  slotMap          Json      @default("{}") @map("slot_map")
  previewUrl       String?   @map("preview_url")
  isSystemTemplate Boolean   @default(false) @map("is_system_template")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPieces ContentPiece[]

  @@map("template_assets")
}

// ============================================================
// PESQUISA, COPY, COMPOSICAO
// ============================================================

model ResearchInsight {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  sourceType      String   @map("source_type")
  sourceRef       String?  @map("source_ref")
  summary         String
  relevanceScore  Decimal  @default(0) @map("relevance_score") @db.Decimal(4, 2)
  suggestedFormat String?  @map("suggested_format")
  consumed        Boolean  @default(false)
  capturedAt      DateTime @default(now()) @map("captured_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentPieces ContentPiece[]

  @@map("research_insights")
}

model ContentPiece {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  insightId       String?  @map("insight_id") @db.Uuid
  templateId      String?  @map("template_id") @db.Uuid
  format          String
  origin          String   @default("manual")
  copyText        String?  @map("copy_text")
  status          String   @default("draft")
  rejectionReason String?  @map("rejection_reason")
  documentUrl     String?  @map("document_url")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  insight      ResearchInsight? @relation(fields: [insightId], references: [id], onDelete: SetNull)
  template     TemplateAsset?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  creator      User?            @relation("ContentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  slides       ContentSlide[]
  publications Publication[]

  @@map("content_pieces")
}

model ContentSlide {
  id                 String   @id @default(uuid()) @db.Uuid
  contentPieceId     String   @map("content_piece_id") @db.Uuid
  slideOrder         Int      @map("slide_order")
  slideText          String?  @map("slide_text")
  imageSource        String   @default("own_library") @map("image_source")
  backgroundImageUrl String?  @map("background_image_url")
  renderedImageUrl   String?  @map("rendered_image_url")
  createdAt          DateTime @default(now()) @map("created_at")

  contentPiece ContentPiece         @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  imageJobs    ImageGenerationJob[]

  @@unique([contentPieceId, slideOrder])
  @@map("content_slides")
}

model ImageGenerationJob {
  id                   String   @id @default(uuid()) @db.Uuid
  contentSlideId       String   @map("content_slide_id") @db.Uuid
  assembledPrompt      String   @map("assembled_prompt")
  modelProvider        String   @map("model_provider")
  referenceImagesUsed  Json     @default("[]") @map("reference_images_used")
  resultImageUrl       String?  @map("result_image_url")
  qaBrandFitScore      Decimal? @map("qa_brand_fit_score") @db.Decimal(3, 1)
  qaArtifactScore      Decimal? @map("qa_artifact_score") @db.Decimal(3, 1)
  qaNegativeSpaceScore Decimal? @map("qa_negative_space_score") @db.Decimal(3, 1)
  attemptNumber        Int      @default(1) @map("attempt_number")
  status               String   @default("pending")
  createdAt            DateTime @default(now()) @map("created_at")

  contentSlide ContentSlide @relation(fields: [contentSlideId], references: [id], onDelete: Cascade)

  @@map("image_generation_jobs")
}

// ============================================================
// CONEXOES & PUBLICACAO
// ============================================================

model SocialAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  network               String
  externalAccountId     String    @map("external_account_id")
  displayName           String?   @map("display_name")
  accessTokenEncrypted  String    @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  status                String    @default("connected")
  connectedAt           DateTime  @default(now()) @map("connected_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publications       Publication[]
  automationTriggers AutomationTrigger[]

  @@unique([workspaceId, network, externalAccountId])
  @@map("social_accounts")
}

model Publication {
  id                String    @id @default(uuid()) @db.Uuid
  contentPieceId    String    @map("content_piece_id") @db.Uuid
  socialAccountId   String    @map("social_account_id") @db.Uuid
  postizReferenceId String?   @map("postiz_reference_id")
  scheduledAt       DateTime  @map("scheduled_at")
  publishedAt       DateTime? @map("published_at")
  status            String    @default("scheduled")
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at")

  contentPiece       ContentPiece        @relation(fields: [contentPieceId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  analyticsSnapshots AnalyticsSnapshot[]

  @@map("publications")
}

model AnalyticsSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  publicationId String   @map("publication_id") @db.Uuid
  reach         Int      @default(0)
  impressions   Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  capturedAt    DateTime @default(now()) @map("captured_at")

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("analytics_snapshots")
}

// ============================================================
// PILOTO AUTOMATICO & BILLING
// ============================================================

model AutopilotPipeline {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @unique @map("workspace_id") @db.Uuid
  isActive         Boolean   @default(false) @map("is_active")
  postsPerWeek     Int       @default(3) @map("posts_per_week")
  formatMix        Json      @default("{\"static_post\": 0.5, \"carousel\": 0.5}") @map("format_mix")
  requiresApproval Boolean   @default(true) @map("requires_approval")
  preferredTimes   Json      @default("[\"09:00\",\"18:00\"]") @map("preferred_times")
  lastRunAt        DateTime? @map("last_run_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("autopilot_pipelines")
}

model Subscription {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @unique @map("workspace_id") @db.Uuid
  planType          String    @default("trial") @map("plan_type")
  maxSocialAccounts Int       @default(1) @map("max_social_accounts")
  maxPostsPerMonth  Int       @default(20) @map("max_posts_per_month")
  billingStatus     String    @default("active") @map("billing_status")
  stripeCustomerId  String?   @map("stripe_customer_id")
  currentPeriodEnd  DateTime? @map("current_period_end")
  createdAt         DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model WorkspaceAddon {
  id                       String   @id @default(uuid()) @db.Uuid
  workspaceId              String   @map("workspace_id") @db.Uuid
  addonKey                 String   @map("addon_key")
  status                   String   @default("active")
  stripeSubscriptionItemId String?  @map("stripe_subscription_item_id")
  activatedAt              DateTime @default(now()) @map("activated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, addonKey])
  @@map("workspace_addons")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ============================================================
// OBSERVABILIDADE / FUNIL / PROMPTS / CENTRAL DE AJUDA (Secao 6.3)
// ============================================================

model FunnelEvent {
  id          String   @id @default(uuid()) @db.Uuid
  anonymousId String   @map("anonymous_id")
  userId      String?  @map("user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  eventName   String   @map("event_name")
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  utmTerm     String?  @map("utm_term")
  utmContent  String?  @map("utm_content")
  metadata    Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("funnel_events")
}

model SystemPrompt {
  promptKey      String   @id @map("prompt_key")
  currentVersion Int      @default(1) @map("current_version")
  content        String
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  updater  User?                 @relation("PromptUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  versions SystemPromptVersion[]

  @@map("system_prompts")
}

model SystemPromptVersion {
  id        String   @id @default(uuid()) @db.Uuid
  promptKey String   @map("prompt_key")
  version   Int
  content   String
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  prompt  SystemPrompt @relation(fields: [promptKey], references: [promptKey], onDelete: Cascade)
  creator User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([promptKey, version])
  @@map("system_prompt_versions")
}

model HelpArticle {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  title           String
  category        String
  contentMarkdown String   @map("content_markdown")
  isPublished     Boolean  @default(false) @map("is_published")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("help_articles")
}

model ChangelogEntry {
  id           String    @id @default(uuid()) @db.Uuid
  title        String
  bodyMarkdown String    @map("body_markdown")
  tag          String
  publishedAt  DateTime? @map("published_at")
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("changelog_entries")
}

// ============================================================
// AUTOMACAO INSTAGRAM (Modulo 19 - add-on pago)
// ============================================================

model AutomationFlow {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  triggers  AutomationTrigger[]
  steps     AutomationFlowStep[]
  runs      AutomationRun[]

  @@map("automation_flows")
}

model AutomationTrigger {
  id               String @id @default(uuid()) @db.Uuid
  automationFlowId String @map("automation_flow_id") @db.Uuid
  triggerType      String @map("trigger_type")
  matchValue       String @map("match_value")
  socialAccountId  String @map("social_account_id") @db.Uuid

  flow          AutomationFlow @relation(fields: [automationFlowId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@map("automation_triggers")
}

model AutomationFlowStep {
  id               String @id @default(uuid()) @db.Uuid
  automationFlowId String @map("automation_flow_id") @db.Uuid
  stepOrder        Int    @map("step_order")
  stepType         String @map("step_type")
  payload          Json   @default("{}")

  flow AutomationFlow @relation(fields: [automationFlowId], references: [id], onDelete: Cascade)

  @@unique([automationFlowId, stepOrder])
  @@map("automation_flow_steps")
}

model AutomationRun {
  id               String   @id @default(uuid()) @db.Uuid
  automationFlowId String   @map("automation_flow_id") @db.Uuid
  triggeredBy      String?  @map("triggered_by")
  status           String   @default("completed")
  errorMessage     String?  @map("error_message")
  executedAt       DateTime @default(now()) @map("executed_at")

  flow AutomationFlow @relation(fields: [automationFlowId], references: [id], onDelete: Cascade)

  @@map("automation_runs")
}
